## HTTPS config for routing tsmbasic.com and its subdomains to the port 3000 app.
## Keep this as a separate Nginx site from the port 3001 thescoremachine.com config.
## Before enabling the HTTPS server block, create the Let's Encrypt certificate with certbot.

server {
    listen 80;
    listen [::]:80;
    server_name tsmbasic.com www.tsmbasic.com admin.tsmbasic.com affiliate.tsmbasic.com super-admin.tsmbasic.com superadmin.tsmbasic.com support.tsmbasic.com funding-manager.tsmbasic.com member.tsmbasic.com printing-team.tsmbasic.com ref.tsmbasic.com refadmin.tsmbasic.com onboarding.tsmbasic.com api.tsmbasic.com db.tsmbasic.com;

    client_max_body_size 100M;

    location /socket.io/ {
        proxy_pass http://127.0.0.1:3000/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        send_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "keep-alive";
    }
}

## After DNS points every name above to this server and certbot succeeds,
## replace the HTTP-only block above with this HTTPS version.
## If certbot edits the file automatically, keep proxy_pass pointed at 127.0.0.1:3000.

